# ---------------------------------------------------------------------------
# home-stack secrets
# ---------------------------------------------------------------------------
# Copy to secrets/smart-home-bot.env. That path is gitignored; this one is not, so
# never put a real value here.
#
# `install.sh --generate-secrets` fills in every key marked [generated] with a
# fresh random value and derives the [derived] ones. You only ever type the
# [required] key and whichever [optional] features you want.
#
# The deployer reads this file, exports only the keys a given service declares
# in deploy/manifest.yml, and refuses to deploy a service whose required keys
# are missing or still empty. That last part is the whole reason this file has
# a shape: an unset key used to reach a container as an empty string, and an
# assistant authenticating with "" fails in a way that looks like a model
# outage rather than a config error.
# ---------------------------------------------------------------------------

# --- The one credential that leaves the house --------------------------- [required]
# Alfred's model. Everything else in this stack runs on the LAN.
#
# An OpenCode key, used against the **Zen** endpoint (https://opencode.ai/zen/v1),
# which is billed per token. The same key also opens the flat Go plan at
# /zen/go/v1 and this stack must not be pointed there: Go's traffic is
# monitored for abuse and this stack is five containers running unattended
# around the clock, which is the shape that gets an account blocked. See
# docs/optional-cloud.md.
#
# Read under its old name OPENCODE_GO_API_KEY as well, so an env file written
# before the move keeps working without re-pasting the key.
OPENCODE_API_KEY=

# --- Portal --------------------------------------------------------- [generated]
# Flask session signing and the /debug/* endpoints. app.py refuses to start
# without these rather than falling back to a default, which is deliberate.
HOMECORE_SECRET_KEY=
HOMECORE_DEBUG_API_KEY=
# The admin page's own session key.
ADMIN_SECRET_KEY=
# The admin page's password, as a bcrypt hash. [asked for by install.sh]
# Deliberately not generated. install.sh asks for it; if it ran without a
# terminal, the admin page serves nothing but its own setup screen until this
# has a value, so it cannot sit open. There is no default and no recovery --
# set a new one from the page, or delete this line to go back to the setup
# screen.
ADMIN_PASSWORD_HASH=

# --- Assistant ------------------------------------------------------ [generated]
# One bearer token per household member, plus the shared room-facing instance.
# The deployer generates exactly as many as `services.nanobot.members` lists.
NANOBOT_API_SECRET_USER_1=
NANOBOT_API_SECRET_USER_2=
NANOBOT_API_SECRET_HOUSE=
NANOBOT_DEBUG_SECRET=

# --- Search --------------------------------------------------------- [generated]
# SearXNG's instance secret. Substituted into the deployed settings.yml on the
# first deploy of `home-search`, replacing the placeholder the image ships;
# after that the file is state and this key is only the seed. Unused while
# `services.home-search.enabled` is false.
SEARXNG_SECRET_KEY=

# --- Code broker ---------------------------------------------------- [generated]
# Derives the per-member token each assistant presents to the code broker. Unset,
# the broker refuses every request -- the right way round for the one service in
# this stack that touches a git remote. The per-member tokens are never written
# here: the deployer computes them at deploy time, so rotating this key cannot
# leave a stale copy behind.
CODE_BROKER_SECRET=

# --- opencode MCP bridge ---------------------------------------------- [generated]
# Derives the token `opencode serve` presents to one member's MCP bridge, which
# is what lets the Programmer profession reach this household's projects, share
# and professions. Only used when services.alfred-mcp is on.
#
# Its own key rather than a reuse of the two above, and that is the point: this
# derived token is written into opencode.json on the *host*, where a person can
# read it. If it were the code broker's token it would also open the broker
# directly, and if it were the proxy's it would open that person's whole portal
# account. It opens the bridge, which authenticates every call again.
ALFRED_MCP_SECRET=

# --- Code broker ------------------------------------------------------- [yours]
# Opens the portal's project-credential door, and nothing else in the stack. Set
# it only if you use the code broker; leave it blank and the broker still runs,
# with no way to read a project's credentials.
PROJECTS_BROKER_TOKEN=

# --- Projects registry ----------------------------------------------- [generated]
# Encrypts the project credentials the portal stores. Unset, the registry
# refuses to store a secret rather than quietly keeping it in plaintext -- so a
# public repo still works and a private one says why it cannot.
PROJECTS_KEY=

# --- Trust between services ----------------------------------------- [generated]
# Shared secret between the chat proxy and the portal.
PROXY_SHARED_SECRET=
# Guards the voice gateway's /v1/tts and /v1/announce.
VOICE_GATEWAY_TOKEN=
# Signs the chat proxy's session cookies -- the same key on the local and the
# cloud copy, so a phone crossing between wifi and mobile data stays signed in.
# (The old HOME_CHAT_PROXY_SECRET was this stack's Jenkins credential ID for
# PROXY_SHARED_SECRET -- one value under two names; the second name is gone.)
PROXY_SESSION_SIGNING_KEY=
# Encrypts `./home-stack backup` archives (AES-256, openssl). Only read
# when backups.encrypt is on. Keep a copy of this somewhere the house
# burning down does not affect: an encrypted backup without its key is
# noise, and nothing anywhere can recover it.
BACKUP_ENCRYPTION_KEY=
# Per-member tokens for the portal's task API.
# [derived] sha256("<PROXY_SHARED_SECRET>:<member id>") — install.sh computes
# these; changing PROXY_SHARED_SECRET without re-deriving them breaks task
# notifications silently, so let the installer own them.
HOMECORE_PROXY_TOKEN_USER_1=
HOMECORE_PROXY_TOKEN_USER_2=

# --- Household share ------------------------------------------------ [generated]
# Samba password for the shared files browser.
SHARE_SMB_PASSWORD=

# --- Documents ------------------------------------------------------ [generated]
# Paperless refuses to start without a Django secret key.
PAPERLESS_SECRET_KEY=
# [optional] Only if you point Paperless at a mailbox.
PAPERLESS_MAIL_PASSWORD=
# [optional] Per-member API tokens, so the assistant can search documents.
# Issue them from the Paperless UI after the first deploy.
PAPERLESS_API_TOKEN_USER_1=
PAPERLESS_API_TOKEN_USER_2=

# --- Optional integrations ------------------------------------------ [optional]
# Each of these is a feature that is simply off when the key is empty. None of
# them fail a deploy by being absent.

# Local Home Assistant, if you run one.
HOMEASSISTANT_TOKEN=

# Wall-panel device token. Optional; without it the menu panel preview still
# works, but a wall-mounted device cannot refresh unattended.
MENU_DEVICE_TOKEN=

# Notifications. Only needed when cloud.notifications.mode is `external`;
# the default `local` mode runs ntfy on the hub and needs nothing here.
# Format is user:password, used as HTTP basic auth (not a bearer token).
NTFY_CREDENTIALS=

# An OpenAI-compatible server of your own -- vLLM, llama.cpp, LM Studio, or a
# hosted provider. Only read when cloud.openai_compatible.enabled is true, and
# optional even then: a server on your own LAN usually wants no key at all.
OPENAI_COMPATIBLE_API_KEY=

# FreeToken, the MoE serving engine, on your own hardware. Only read when
# cloud.freetoken.enabled is true, and optional even then -- it is a server on
# your own desk and usually takes no key. Its own variable rather than sharing
# the one above, so both can be configured at once.
FREETOKEN_API_KEY=

# Certificates. Only when cloud.certificates.mode is `acme-dns`. The default
# `local-ca` mode issues its own and needs nothing here.
ACME_DNS_API_TOKEN=


# Web search for the assistant. Set at most one.
TAVILY_API_KEY=
BRAVE_API_KEY=
KAGI_API_KEY=
JINA_API_KEY=

# Local n8n, if you run one.
NANOBOT_N8N_API_KEY=

# Web scraping for the assistant's browsing skill (Bright Data). The compose
# file read this all along; it just was not documented anywhere a person would
# find it.
BRIGHTDATA_API_TOKEN=


# crawl4ai needs no key from you, and there is nothing to fill in here.
#
# Its token is *derived* from PROXY_SHARED_SECRET at deploy time, the way the
# portal's per-person tokens and the code broker's are -- see
# `derive_crawl4ai_secret` in deploy/deploy.py. There is nobody to obtain a
# token from: the server is the household's own. The value exists at all only
# because crawl4ai's entrypoint reads it to decide whether to listen on
# anything but its own loopback, so an empty one does not mean "no auth", it
# means "unreachable".
#
# Setting one here overrides the derivation. Worth doing only if you are
# putting something else in front of that container.
# CRAWL4AI_API_TOKEN=
# CRAWL4AI_SECRET_KEY=

# A second model provider some assistant skills can use.
# openrouter.ai: one key, most models, pay per token. A model written
# `openrouter:<name>` in assistant.models goes here.
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# OpenAI itself. A model written `openai:<name>` in assistant.models goes here.
# Each of these three is a *source* as well as a destination: fill one in and
# the admin page's Models list starts offering what that account can reach.
# Leave it empty and the provider is simply not on offer.
OPENAI_API_KEY=

# The vision model, only when cloud.ollama.mode is `cloud`. The default `local`
# mode points at an Ollama on your own network and needs nothing here — the key
# is the literal "ollama", which a local Ollama expects and ignores.
#
# This is the second credential that leaves the house, and worth a thought
# before switching: what goes to it is camera frames and any photo somebody
# sends the assistant.
OLLAMA_API_KEY=
