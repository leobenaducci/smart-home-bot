# Copy to .env on the VPS and fill in. Never commit the real .env.

# Home side of the reverse tunnel where HomeCore local is reachable from the VPS.
# WireGuard example: https://10.8.0.2:8443   (or https://127.0.0.1:8443 for autossh -R)
HOMECORE_LOCAL_URL=https://10.8.0.2:8443

# Shared secret between this proxy and HomeCore local. Set the SAME value in
# HomeCore local's environment (PROXY_SHARED_SECRET). Generate: openssl rand -hex 32
PROXY_SHARED_SECRET=

# Signs the family's session cookies. Rotating this logs everyone out.
# Generate: openssl rand -hex 32
SESSION_SIGNING_KEY=

# Days a phone stays logged in. Default is very long so the session lasts until
# the user taps "Salir" (logout); lower it if you want periodic re-auth.
TOKEN_EXPIRE_DAYS=3650

# ntfy server used for push notifications (see docs/proxy-notifications.md). Optional,
# defaults to this value if unset.
NTFY_BASE_URL=https://ntfy.home
