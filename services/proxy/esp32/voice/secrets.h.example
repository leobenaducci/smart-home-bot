// Optional compile-time defaults. Copy to secrets.h and fill in to flash a
// pre-provisioned puck; without it the config portal is the only way in, which
// is the path that works for a device already sitting on a shelf.
//
// NVS always wins: anything saved through the portal overrides these, so a
// stale value here cannot quietly override a working configuration.
//
// secrets.h is gitignored (home-chat/.gitignore: esp32/**/secrets.h).
#pragma once

#define WIFI_SSID     "Sam y Alex"
#define WIFI_PASSWORD ""

// The voice gateway on compute. Plain HTTP — it is LAN-only.
#define VOICE_URL "http://compute.home:8081"

// This device's token, which must exist in the gateway's devices.json at
// /home/homestack/home-lab/configs/home-voice/devices.json on compute.
// That file is what decides which room this puck is in — not anything here.
//   python3 -c "import secrets; print(secrets.token_hex(16))"
#define VOICE_DEVICE_TOKEN ""
