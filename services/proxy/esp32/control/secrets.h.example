// Optional compile-time WiFi defaults. Copy to secrets.h to flash a
// pre-provisioned panel; without it the config portal (RESET twice) is the way
// in, which is the path that works for a panel already on a wall.
//
// NVS always wins over these.
//
// There is nothing else to configure: this panel talks to the lights server and
// the camera server, both of which are plain HTTP on the LAN and ask for no
// credential. Their addresses are compiled in via board_config.h.
//
// secrets.h is gitignored (home-chat/.gitignore: esp32/**/secrets.h).
#pragma once

#define WIFI_SSID     "Sam y Alex"
#define WIFI_PASSWORD ""
