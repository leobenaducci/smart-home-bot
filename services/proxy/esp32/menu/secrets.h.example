// Copy to secrets.h and fill in. secrets.h is gitignored.
//
// **This file is optional.** The sketch compiles and runs without it: with no
// stored settings the panel opens its config portal instead (see README). What
// this gives you is a panel that is already provisioned the first time it
// boots, which is quicker on the bench and useless once it's on a wall.
//
// These are only *defaults*. Anything saved through the portal lives in NVS and
// wins, so editing and reflashing this file will not override a panel that has
// been configured over the air - erase flash if that's what you want.
#pragma once

#define WIFI_SSID      "your-ssid"
#define WIFI_PASSWORD  "your-password"

// HomeCore on the LAN. Must be reachable without the VPN, since the panel has no
// Tailscale client - this is the plain home network address.
#define MENU_URL  "https://hub.home:21001/menu/api/render.bin"

// Must equal MENU_DEVICE_TOKEN in HomeCore's environment. Generate with:
//   openssl rand -hex 32
#define MENU_DEVICE_TOKEN  "change-me"

// Static IP lives in board_config.h, not here — it isn't a secret, and this
// file is optional whereas that one always exists.
