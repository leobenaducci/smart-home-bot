# ---------------------------------------------------------------------------
# home-stack
# ---------------------------------------------------------------------------
# Real secrets. The .example beside it is committed and documents every key.
/secrets/smart-home-bot.env
# The lock the admin page takes while rewriting that file. Empty by
# construction -- it is an flock target, never written to -- but it is created
# next to real credentials, and a stray file in this directory is the one place
# a mistake is expensive. Ignored so it cannot be committed by an `add -A`,
# which is exactly how it got committed once.
/secrets/*.lock
# The scratch copies of that file, written beside it by the admin page
# (`smart-home-bot.tmp`) and by install.sh (`smart-home-bot.env.tmp`) on every
# read-modify-write. Unlike the lock these are *not* empty -- each one holds
# every credential in the house -- and either can outlive a crashed write.
/secrets/*.tmp
# Hand-made copies of that file, kept beside it while renaming a key or
# rotating one. Same contents as the live file -- every credential in the
# house, the backup encryption key included -- and unlike the .tmp files
# nothing deletes them, so they sit here until somebody notices. Ignored for
# the same reason the lock is: `git add -A` in this directory is expensive.
/secrets/*.bak
/secrets/*.orig
/secrets/*.save

# The live site configuration. config/home-stack.example.yml is committed;
# this is the copy install.sh makes and the admin page edits.
/config/home-stack.yml
/config/*.yml.tmp

# The installer's virtualenv.
/.venv/

# Issued certificates and the local CA.
/services/home-core/proxy/certs/
# The portal's own TLS pair. Generated on the machine by
# local/ensure-cert.sh into the state directory; a copy used to be committed
# here, which is a private key in every clone.
/services/home-core/local/certs/

# Live configuration that belongs on the target hosts, never in the repo.
# Anything a deploy could destroy lives outside the deploy directory -- see
# the note at the top of deploy/manifest.yml.
/services/*/config/*.json
!/services/*/config/*.example.json
/config/pending-deploy.json

# Per-member files a running house creates from the shipped templates. The
# template and the README are the only ones that belong in the package.
/services/nanobot/user-profiles/*.md
!/services/nanobot/user-profiles/README.md
!/services/nanobot/user-profiles/user-profile.template.md

# Real per-member overlays (WhatsApp linkage etc.); the .example is tracked.
/services/nanobot/shared-config/config.user*.json
!/services/nanobot/shared-config/config.userN.json.example

# The admin page's needs-deploy record.

# deploy.sh keeps the last run here.
/deploy-last.log

# The household's own identifiers, for re-running the extraction.
# Never tracked: see the docstring in the file itself.
/deploy/sanitize-rules.local.py

# Rendered by deploy/compose_members.py before every deploy and every contract
# check, from the members this household has. Never the same on two installs,
# and never out of date -- so there is nothing to track.
/services/nanobot/docker-compose.members.yml

# Rendered by deploy/compose_alfred_mcp.py, from the members who have the
# Programmer switched on. Carries their ids and their folders on the share, so
# tracking it would put household identifiers in the package.
/services/alfred-mcp/docker-compose.members.yml

# Rendered by deploy/compose_admin.py: this household's plugin directories.
/admin/docker-compose.plugins.yml


# The Android app signing key is the household's own and lives in the config
# directory (alfred-app/debug.keystore). Whoever holds it can sign updates.
*.keystore
*.jks

# Hand-made backup copies of files being edited.
*.bak
*.bak-*
